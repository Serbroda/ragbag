<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

	<!-- One-time password reset links created by instance admins. Only a SHA-256 hash of the token is stored.
		 Constraints are inline so the same changeset works on SQLite. -->
	<changeSet id="2026-10-26: create table password_resets" author="serbroda">
		<createTable tableName="password_resets">
			<column name="token_hash" type="varchar(64)">
				<constraints primaryKey="true" primaryKeyName="pk_password_resets"/>
			</column>
			<column name="user_id" type="varchar(36)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uc_password_resets_user_id"
						referencedTableName="users" referencedColumnNames="id"
						foreignKeyName="fk_password_resets_user_id" deleteCascade="true"/>
			</column>
			<column name="created_by" type="varchar(36)"/>
			<column name="expires_at" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
		</createTable>
	</changeSet>

</databaseChangeLog>
