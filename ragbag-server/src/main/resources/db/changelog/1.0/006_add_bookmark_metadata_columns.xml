<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

	<changeSet id="2026-02-15: add bookmark metadata columns" author="serbroda">
		<!-- Was varchar(max), which only SQL Server understands. Databases that already ran the
		     old version (H2 dev databases) keep working; new ones get the portable type. -->
		<validCheckSum>ANY</validCheckSum>
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="bookmarks" columnName="og_image"/>
			</not>
		</preConditions>

		<addColumn tableName="bookmarks">
			<column name="og_image" type="text"/>
			<column name="favicon" type="text"/>
			<column name="canonical" type="text"/>
		</addColumn>
	</changeSet>

</databaseChangeLog>
