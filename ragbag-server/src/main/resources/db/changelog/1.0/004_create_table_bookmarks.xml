<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="2026-02-01: create table bookmarks" author="serbroda">
        <!-- Was varchar(max), which only SQL Server understands. Databases that already ran the
             old version (H2 dev databases) keep working; new ones get the portable type. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bookmarks"/>
            </not>
        </preConditions>

        <createTable tableName="bookmarks">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" primaryKeyName="pk_bookmarks_id"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="varchar(36)">
                <constraints nullable="false" referencedTableName="users" referencedColumnNames="id"
                             foreignKeyName="fk_bookmarks_created_by_users_id"/>
            </column>

            <column name="collection_id" type="varchar(36)">
                <constraints nullable="false" referencedTableName="collections" referencedColumnNames="id"
                             foreignKeyName="fk_bookmarks_collection_id"/>
            </column>

            <column name="url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

</databaseChangeLog>