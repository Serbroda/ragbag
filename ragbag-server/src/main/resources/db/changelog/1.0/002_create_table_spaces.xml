<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="2026-02-01: create table spaces" author="serbroda">
        <!-- Was varchar(max), which only SQL Server understands. Databases that already ran the
             old version (H2 dev databases) keep working; new ones get the portable type. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="spaces"/>
            </not>
        </preConditions>

        <createTable tableName="spaces">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" primaryKeyName="pk_spaces_id"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="varchar(36)">
                <constraints nullable="false" referencedTableName="users" referencedColumnNames="id"
                             foreignKeyName="fk_spaces_created_by_users_id"/>
            </column>

            <column name="name" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-02-01: create table spaces_members" author="serbroda" dbms="!sqlite">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="spaces_members"/>
            </not>
        </preConditions>

        <createTable tableName="spaces_members">
            <column name="space_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="spaces_members" columnNames="space_id,user_id"
                             constraintName="uc_spaces_members"/>
    </changeSet>

    <!-- SQLite cannot add constraints to existing tables, so it gets the same table with inline constraints -->
    <changeSet id="2026-10-26: create table spaces_members (sqlite)" author="serbroda" dbms="sqlite">
        <createTable tableName="spaces_members">
            <column name="space_id" type="varchar(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="uc_spaces_members"/>
            </column>
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="uc_spaces_members"/>
            </column>
            <column name="role" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>