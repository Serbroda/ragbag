<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

	<changeSet id="2026-10-26: create table bookmark_favorites" author="serbroda" dbms="!sqlite">
		<createTable tableName="bookmark_favorites">
			<column name="user_id" type="varchar(36)">
				<constraints nullable="false"/>
			</column>
			<column name="bookmark_id" type="varchar(36)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
		</createTable>

		<addPrimaryKey tableName="bookmark_favorites" columnNames="user_id,bookmark_id"
				constraintName="pk_bookmark_favorites"/>

		<!-- Favorites disappear together with their user or bookmark -->
		<addForeignKeyConstraint baseTableName="bookmark_favorites" baseColumnNames="user_id"
				referencedTableName="users" referencedColumnNames="id"
				constraintName="fk_bookmark_favorites_user_id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="bookmark_favorites" baseColumnNames="bookmark_id"
				referencedTableName="bookmarks" referencedColumnNames="id"
				constraintName="fk_bookmark_favorites_bookmark_id" onDelete="CASCADE"/>
	</changeSet>

	<!-- SQLite cannot add constraints to existing tables, so it gets the same table with inline constraints -->
	<changeSet id="2026-10-26: create table bookmark_favorites (sqlite)" author="serbroda" dbms="sqlite">
		<createTable tableName="bookmark_favorites">
			<column name="user_id" type="varchar(36)">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_bookmark_favorites"
						referencedTableName="users" referencedColumnNames="id"
						foreignKeyName="fk_bookmark_favorites_user_id" deleteCascade="true"/>
			</column>
			<column name="bookmark_id" type="varchar(36)">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_bookmark_favorites"
						referencedTableName="bookmarks" referencedColumnNames="id"
						foreignKeyName="fk_bookmark_favorites_bookmark_id" deleteCascade="true"/>
			</column>
			<column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP"/>
		</createTable>
	</changeSet>

</databaseChangeLog>
