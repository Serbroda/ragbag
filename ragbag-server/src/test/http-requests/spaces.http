@SPACE_ID = {{__SPACE_ID__}}

### Get all spaces

GET {{host}}/api/v1/spaces
Authorization: {{__SESSION_AUTH_HEADER__}}
Content-Type: application/json

> {%
    client.global.set("__SPACE_ID__", response.body[0].id);
%}

### Get a space

GET {{host}}/api/v1/spaces/{{SPACE_ID}}
Authorization: {{__SESSION_AUTH_HEADER__}}
Content-Type: application/json

### Update a space

PUT {{host}}/api/v1/spaces/{{SPACE_ID}}
Authorization: {{__SESSION_AUTH_HEADER__}}
Content-Type: application/json

{
  "name": "Renamed Space",
  "description": "Updated description"
}

### Leave a space

POST {{host}}/api/v1/spaces/{{SPACE_ID}}/leave
Authorization: {{__SESSION_AUTH_HEADER__}}

### Delete a space

DELETE {{host}}/api/v1/spaces/{{SPACE_ID}}
Authorization: {{__SESSION_AUTH_HEADER__}}
