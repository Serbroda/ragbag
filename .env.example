# Copy to .env and adjust. docker compose reads it automatically.

RAGBAG_PORT=8080

# Only used by docker-compose.postgres.yaml
DB_NAME=ragbag
DB_USER=ragbag
DB_PASSWORD=change-me-db-password

# openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# true when Ragbag is served via HTTPS (reverse proxy with TLS)
SECURE_COOKIE=false

# openssl rand -base64 32 (comma-separated for several keys) to open /actuator;
# also uncomment ACTUATOR_API_KEYS in the compose file
#ACTUATOR_API_KEYS=

# Disable after creating your accounts if the instance is publicly reachable
REGISTRATION_ENABLED=true

# Let Ragbag load link titles from private addresses like 192.168.x.x
ALLOW_PRIVATE_HOSTS=false
