# Copy to .env and adjust. docker compose reads it automatically.

RAGBAG_PORT=8080

# Only used by docker-compose.postgres.yaml
DB_NAME=ragbag
DB_USER=ragbag
DB_PASSWORD=change-me-db-password

# openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Detected automatically for HTTPS (also behind a reverse proxy); true forces the Secure cookie flag
SECURE_COOKIE=false

# Usernames that may manage all users and create password reset links (comma-separated)
ADMIN_USERS=

# Disable after creating your accounts if the instance is publicly reachable
REGISTRATION_ENABLED=true

# Slow down password guessing, bot sign-ups and floods (per IP, user and account); keep it on when public
RATE_LIMIT_ENABLED=true

# Quotas keep single accounts from filling the disk on public instances (empty: unlimited), e.g.
#QUOTA_LINKS_PER_USER=10000
#QUOTA_SPACES_PER_USER=10
#QUOTA_COLLECTIONS_PER_SPACE=500
#QUOTA_UPLOAD_MB_PER_USER=200

# Let Ragbag load link titles from private addresses like 192.168.x.x
ALLOW_PRIVATE_HOSTS=false

# Logs go to stdout (docker logs / journalctl). A file instead, rotated at LOG_MAX_SIZE_MB, LOG_MAX_FILES kept:
#LOG_FILE=/data/logs/ragbag.log
# debug, info, warn or error; text or json
#LOG_LEVEL=info
#LOG_FORMAT=text
#LOG_MAX_SIZE_MB=10
#LOG_MAX_FILES=5
