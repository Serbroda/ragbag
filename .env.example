# Every setting of Ragbag with its default. For Docker: copy to .env, docker compose reads it for both compose
# files. Without Docker the same variables go into /etc/ragbag/ragbag.env (systemd) or .env.local (from source).
# Empty values mean the default.

# ── Docker compose only (the server never reads these) ─────────────────────────────────────────────────────────
# Port on the host; inside the container Ragbag always listens on 8080
RAGBAG_PORT=8080
# Only docker-compose.postgres.yaml, which builds DATABASE_URL from them
DB_NAME=ragbag
DB_USER=ragbag
DB_PASSWORD=change-me-db-password

# ── Server ─────────────────────────────────────────────────────────────────────────────────────────────────────
# The address Ragbag is reached at, e.g. https://ragbag.example.com: links in emails, link previews in chat apps,
# the admin overview.
# Required with SMTP_HOST
PUBLIC_URL=

# Fixed inside the container (listening on :8080, the database and files in /data), so only without Docker:
# Address to listen on
#RAGBAG_ADDR=:8080
# SQLite file or PostgreSQL, e.g. postgres://ragbag:password@localhost:5432/ragbag?sslmode=disable
#DATABASE_URL=sqlite:data/ragbag.db
# Files next to the database (initial-admin-password, legal/, backups/); default: the SQLite file's directory,
# systemd's state directory (/var/lib/ragbag), else ./data
#DATA_DIR=

# ── Sign-in ────────────────────────────────────────────────────────────────────────────────────────────────────
# Required, at least 32 characters: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
# How long a device stays signed in without being used (14 days)
REFRESH_TOKEN_MINUTES=20160
# Detected automatically for HTTPS (also behind a reverse proxy); true forces the Secure cookie flag
SECURE_COOKIE=false

# ── Accounts ───────────────────────────────────────────────────────────────────────────────────────────────────
# Usernames that may manage all users, decide on reports and download backups (comma-separated). The first start
# of an empty instance creates the first of them ("admin" when empty) with a random password in
# DATA_DIR/initial-admin-password:  docker compose exec app cat /data/initial-admin-password
ADMIN_USERS=
# Switch off once everybody has an account if the instance is reachable from the internet. New people can still
# register with an invite link of an admin (and join that space)
REGISTRATION_ENABLED=true
# Slow down password guessing, bot sign-ups and floods (per IP, user and account); keep it on when public
RATE_LIMIT_ENABLED=true
# Let Ragbag load link titles from private addresses like 192.168.x.x (homelab dashboards). Not with open
# registration: anybody could make the server load addresses of your network
ALLOW_PRIVATE_HOSTS=false
# Other origins allowed to call the API with credentials, comma-separated; only needed for the Vite dev server
# (http://localhost:5173)
CORS_ALLOWED_ORIGINS=

# ── Email (optional; nothing is sent while SMTP_HOST is empty) ─────────────────────────────────────────────────
# New accounts confirm their address, everybody can reset a forgotten password, admins hear about reports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Ragbag <ragbag@example.com>
# starttls (587), tls (465) or none (relay on the same host)
SMTP_TLS=starttls

# ── Quotas (empty or 0: unlimited) ─────────────────────────────────────────────────────────────────────────────
# E.g. 10000 links, 10 spaces, 500 collections per space, 200 MB of images
QUOTA_LINKS_PER_USER=
QUOTA_SPACES_PER_USER=
QUOTA_COLLECTIONS_PER_SPACE=
QUOTA_UPLOAD_MB_PER_USER=

# ── Legal pages ────────────────────────────────────────────────────────────────────────────────────────────────
# Markdown files in DATA_DIR/legal (imprint.md, privacy.md, terms.md; templates in docs/legal), or addresses
# elsewhere
IMPRINT_URL=
PRIVACY_URL=
TERMS_URL=

# ── Backups ────────────────────────────────────────────────────────────────────────────────────────────────────
# The server backs itself up every BACKUP_INTERVAL_HOURS and keeps the newest BACKUP_KEEP (0 is off). Copy them
# to another machine now and then.
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=24
# Only without Docker (in the container: /data/backups); default DATA_DIR/backups
#BACKUP_DIR=

# ── Logs ───────────────────────────────────────────────────────────────────────────────────────────────────────
# debug, info, warn or error; text or json
LOG_LEVEL=info
LOG_FORMAT=text
# Empty: stdout (docker logs, limited to 5 × 10 MB by the compose files; journald with systemd). A file instead,
# e.g. /data/logs/ragbag.log (Docker) or /var/log/ragbag/ragbag.log (systemd): a new one daily and at
# LOG_MAX_SIZE_MB, LOG_MAX_FILES compressed ones kept, deleted after LOG_MAX_AGE_DAYS
LOG_FILE=
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
LOG_MAX_AGE_DAYS=7
# Log IP addresses without their last part (rate limits still use the full address)
LOG_ANONYMIZE_IP=false
