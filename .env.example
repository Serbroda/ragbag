# Copy to .env and adjust; docker compose reads it for both compose files. Every variable is documented in the
# README (Configuration). Empty values mean the default.

# Port on the host
RAGBAG_PORT=8080

# Only used by docker-compose.postgres.yaml
DB_NAME=ragbag
DB_USER=ragbag
DB_PASSWORD=change-me-db-password

# Required, at least 32 characters: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# The address Ragbag is reached at, e.g. https://ragbag.example.com: links in emails and the admin overview
PUBLIC_URL=

# Usernames that may manage all users, decide on reports and download backups (comma-separated). The first start
# of an empty instance creates the first of them ("admin" when empty) with a random password in
# /data/initial-admin-password:  docker compose exec app cat /data/initial-admin-password
ADMIN_USERS=

# Switch off once everybody has an account if the instance is reachable from the internet
REGISTRATION_ENABLED=true

# Slow down password guessing, bot sign-ups and floods (per IP, user and account); keep it on when public
RATE_LIMIT_ENABLED=true

# Detected automatically for HTTPS (also behind a reverse proxy); true forces the Secure cookie flag
SECURE_COOKIE=false

# Let Ragbag load link titles from private addresses like 192.168.x.x (homelab dashboards). Not with open
# registration: anybody could make the server load addresses of your network
ALLOW_PRIVATE_HOSTS=false

# Email (optional): new accounts confirm their address, everybody can reset a forgotten password, admins hear
# about reports. Needs PUBLIC_URL. Without SMTP_HOST nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Ragbag <ragbag@example.com>
# starttls (587), tls (465) or none (relay on the same host)
SMTP_TLS=starttls

# Quotas keep single accounts from filling the disk on public instances (empty or 0: unlimited), e.g.
# 10000 links, 10 spaces, 500 collections per space, 200 MB of images
QUOTA_LINKS_PER_USER=
QUOTA_SPACES_PER_USER=
QUOTA_COLLECTIONS_PER_SPACE=
QUOTA_UPLOAD_MB_PER_USER=

# Logs go to stdout (docker logs). A file instead, rotated at LOG_MAX_SIZE_MB with LOG_MAX_FILES kept,
# e.g. /data/logs/ragbag.log
LOG_FILE=
# debug, info, warn or error; text or json
LOG_LEVEL=info
LOG_FORMAT=text
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
