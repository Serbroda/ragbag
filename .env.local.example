# Local development settings, loaded by the server from the working directory (`make dev` copies this file to
# .env.local if it is missing). .env.local is not committed; values set in the real environment always win.
# For Docker, use .env (see .env.example) instead. Locally Ragbag runs exactly like in production.

# SQLite file (directories are created) or e.g. postgres://ragbag:ragbag@localhost:5432/ragbag?sslmode=disable
DATABASE_URL=sqlite:data/ragbag.db

# Required, at least 32 characters (openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Instance admins. The first start with an empty database creates "admin" with a random password in
# data/initial-admin-password and opens the setup (start fresh or restore a backup)
ADMIN_USERS=admin

# The Vite dev server (make dev-ui)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Let "Fetch details" load pages from your own network (192.168.x.x)
ALLOW_PRIVATE_HOSTS=true

# More detail while developing; LOG_FILE=data/ragbag.log writes a (rotating) file instead of the console
LOG_LEVEL=debug

# Further options with their defaults (see the README):
# RAGBAG_ADDR=:8080
# PUBLIC_URL=
# REGISTRATION_ENABLED=true
# RATE_LIMIT_ENABLED=true
# SECURE_COOKIE=false
# DATA_DIR=            (the directory of the SQLite file)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_MINUTES=20160
# QUOTA_LINKS_PER_USER= QUOTA_SPACES_PER_USER= QUOTA_COLLECTIONS_PER_SPACE= QUOTA_UPLOAD_MB_PER_USER=
# PLANS_ENABLED=true QUOTA_PRO_SPACES_PER_USER= QUOTA_PRO_UPLOAD_MB_PER_USER= PLANS_FREE_API_TOKENS=true
# SUPPORT_URL=https://ko-fi.com/<name>
#
# Email, e.g. against a local Mailpit (podman run -p 1025:1025 -p 8025:8025 axllent/mailpit):
# PUBLIC_URL=http://localhost:8080
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_TLS=none
# SMTP_FROM=Ragbag <ragbag@localhost>
