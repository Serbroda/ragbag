# Local development settings, loaded by the server from the working directory (`make dev` copies this file to
# .env.local if it is missing). .env.local is not committed; values set in the real environment always win.
# For Docker, use .env (see .env.example) instead.

# Demo account admin/test123 and relaxed defaults; never use it in production
RAGBAG_DEV=true

# SQLite file (directories are created) or e.g. postgres://ragbag:ragbag@localhost:5432/ragbag?sslmode=disable
DATABASE_URL=sqlite:data/ragbag.db

# At least 32 characters (openssl rand -base64 32); keeps you signed in across restarts
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Usernames that may manage all users and create password reset links
ADMIN_USERS=admin

# The Vite dev server (make dev-ui)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Let "Fetch details" load pages from your own network (192.168.x.x)
ALLOW_PRIVATE_HOSTS=true

# More detail while developing; LOG_FILE=data/ragbag.log writes a (rotating) file instead of the console
LOG_LEVEL=debug

# Further options with their defaults:
# RAGBAG_ADDR=:8080
# REGISTRATION_ENABLED=true
# SECURE_COOKIE=false
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_MINUTES=20160
